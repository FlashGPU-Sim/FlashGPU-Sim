+CUTLASS_DEVICE
+void profile_clock_min(uint64_t *ptr, uint64_t value) {
+#if defined(FLASH_FWD_PROFILE_CLOCK_NON_ATOMIC)
+    if (blockIdx.x == 0 && blockIdx.y == 0 && blockIdx.z == 0 && value < *ptr) {
+        *ptr = value;
+    }
+#else
+    atomicMin(reinterpret_cast<unsigned long long*>(ptr),
+              static_cast<unsigned long long>(value));
+#endif
+}
+
+CUTLASS_DEVICE
+void profile_clock_max(uint64_t *ptr, uint64_t value) {
+#if defined(FLASH_FWD_PROFILE_CLOCK_NON_ATOMIC)
+    if (blockIdx.x == 0 && blockIdx.y == 0 && blockIdx.z == 0 && value > *ptr) {
+        *ptr = value;
+    }
+#else
+    atomicMax(reinterpret_cast<unsigned long long*>(ptr),
+              static_cast<unsigned long long>(value));
+#endif
+}
+
+CUTLASS_DEVICE
+uint32_t profile_clock_smid() {
+    uint32_t smid = 0;
+    asm volatile("mov.u32 %0, %%smid;" : "=r"(smid));
+    return smid;
+}
