index 0000000..ed24eaa
--- /dev/null
+++ b/hopper/flash_profile.h
@@ -0,0 +1,176 @@
+/******************************************************************************
+ * Optional profiling indices for local FA3 forward experiments.
+ ******************************************************************************/
+
+#pragma once
+
+#include <cstdint>
+
+enum FlashFwdProfileClockIndex : int {
+    kFlashFwdProfileKernelStart = 0,
+    kFlashFwdProfileKernelEnd = 1,
+    kFlashFwdProfileMainloopStart = 2,
+    kFlashFwdProfileMainloopEnd = 3,
+    kFlashFwdProfileEpilogueStart = 4,
+    kFlashFwdProfileEpilogueEnd = 5,
+    kFlashFwdProfileQkWaitCycles = 6,
+    kFlashFwdProfileQkWgmmaIssueCycles = 7,
+    kFlashFwdProfileSoftmaxCycles = 8,
+    kFlashFwdProfilePvWaitCycles = 9,
+    kFlashFwdProfilePvWgmmaIssueWaitCycles = 10,
+    kFlashFwdProfileMainloopIterations = 11,
+    kFlashFwdProfileAggregateCount = 12
+};
+
+enum FlashFwdProfileTraceStepKind : int {
+    kFlashFwdProfileTraceUnused = 0,
+    kFlashFwdProfileTraceInitialQk = 1,
+    kFlashFwdProfileTraceSteady = 2,
+    kFlashFwdProfileTraceFinalPv = 3
+};
+
+enum FlashFwdProfileTraceFieldIndex : int {
+    kFlashFwdProfileTraceKind = 0,
+    kFlashFwdProfileTraceNBlock = 1,
+    kFlashFwdProfileTraceStart = 2,
+    kFlashFwdProfileTraceEnd = 3,
+    kFlashFwdProfileTraceQkWaitCycles = 4,
+    kFlashFwdProfileTraceQkWgmmaIssueCycles = 5,
+    kFlashFwdProfileTraceSoftmaxCycles = 6,
+    kFlashFwdProfileTracePvWaitCycles = 7,
+    kFlashFwdProfileTracePvWgmmaIssueWaitCycles = 8,
+    kFlashFwdProfileTraceFieldCount = 9
+};
+
+static constexpr int kFlashFwdProfileTraceMaxSteps = 512;
+static constexpr int kFlashFwdProfileTraceBase = kFlashFwdProfileAggregateCount;
+static constexpr int kFlashFwdProfileTraceClockCount =
+    kFlashFwdProfileTraceMaxSteps * kFlashFwdProfileTraceFieldCount;
+
+enum FlashFwdProfileTimelineActor : int {
+    kFlashFwdProfileTimelineProducer = 0,
+    kFlashFwdProfileTimelineConsumerLow = 1,
+    kFlashFwdProfileTimelineConsumerHigh = 2,
+    kFlashFwdProfileTimelineActorCount = 3
+};
+
+enum FlashFwdProfileTimelineEvent : int {
+    kFlashFwdProfileTimelineTileBegin = 0,
+    kFlashFwdProfileTimelineProducerLoadKBegin = 1,
+    kFlashFwdProfileTimelineProducerLoadKEnd = 2,
+    kFlashFwdProfileTimelineProducerLoadVBegin = 3,
+    kFlashFwdProfileTimelineProducerLoadVEnd = 4,
+    kFlashFwdProfileTimelineProducerBarrierOBegin = 5,
+    kFlashFwdProfileTimelineProducerBarrierOEnd = 6,
+    kFlashFwdProfileTimelineProducerTailBegin = 7,
+    kFlashFwdProfileTimelineProducerTailEnd = 8,
+    kFlashFwdProfileTimelineConsumerStepBegin = 9,
+    kFlashFwdProfileTimelineConsumerKWaitBegin = 10,
+    kFlashFwdProfileTimelineConsumerKWaitEnd = 11,
+    kFlashFwdProfileTimelineConsumerSchedulerWaitBegin = 12,
+    kFlashFwdProfileTimelineConsumerSchedulerWaitEnd = 13,
+    kFlashFwdProfileTimelineConsumerQkIssueBegin = 14,
+    kFlashFwdProfileTimelineConsumerQkIssueEnd = 15,
+    kFlashFwdProfileTimelineConsumerPvWaitBegin = 16,
+    kFlashFwdProfileTimelineConsumerPvWaitEnd = 17,
+    kFlashFwdProfileTimelineConsumerPvIssueBegin = 18,
+    kFlashFwdProfileTimelineConsumerSchedulerArrive = 19,
+    kFlashFwdProfileTimelineConsumerWait1End = 20,
+    kFlashFwdProfileTimelineConsumerKRelease = 21,
+    kFlashFwdProfileTimelineConsumerWait0Begin = 22,
+    kFlashFwdProfileTimelineConsumerWait0End = 23,
+    kFlashFwdProfileTimelineConsumerVRelease = 24,
+    kFlashFwdProfileTimelineConsumerStepEnd = 25,
+    kFlashFwdProfileTimelineEventCount = 26
+};
+
+static constexpr int kFlashFwdProfileTimelineMaxSteps = 48;
+static constexpr int kFlashFwdProfileTimelineBase =
+    kFlashFwdProfileTraceBase + kFlashFwdProfileTraceClockCount;
+static constexpr int kFlashFwdProfileTimelineClockCount =
+    kFlashFwdProfileTimelineActorCount *
+    kFlashFwdProfileTimelineMaxSteps *
+    kFlashFwdProfileTimelineEventCount;
+
+enum FlashFwdProfileRegTimelineEvent : int {
+    kFlashFwdProfileRegTimelineSchedulerWaitBefore = 0,
+    kFlashFwdProfileRegTimelineSchedulerWaitAfter = 1,
+    kFlashFwdProfileRegTimelineQkIssueBegin = 2,
+    kFlashFwdProfileRegTimelineQkIssueEnd = 3,
+    kFlashFwdProfileRegTimelinePvIssueBegin = 4,
+    kFlashFwdProfileRegTimelinePvIssueEnd = 5,
+    kFlashFwdProfileRegTimelineSchedulerArriveBefore = 6,
+    kFlashFwdProfileRegTimelineSchedulerArriveAfter = 7,
+    kFlashFwdProfileRegTimelineWait1Before = 8,
+    kFlashFwdProfileRegTimelineWait1After = 9,
+    kFlashFwdProfileRegTimelineWait0Before = 10,
+    kFlashFwdProfileRegTimelineWait0After = 11,
+    kFlashFwdProfileRegTimelineEventCount = 12
+};
+
+#ifndef FLASH_FWD_PROFILE_REG_TIMELINE_STEPS
+#define FLASH_FWD_PROFILE_REG_TIMELINE_STEPS 2
+#endif
+
+#ifndef FLASH_FWD_PROFILE_REG_TIMELINE_BLOCKS
+#define FLASH_FWD_PROFILE_REG_TIMELINE_BLOCKS 256
+#endif
+
+static constexpr int kFlashFwdProfileRegTimelineMaxSteps =
+    FLASH_FWD_PROFILE_REG_TIMELINE_STEPS;
+static constexpr int kFlashFwdProfileRegTimelineMaxBlocks =
+    FLASH_FWD_PROFILE_REG_TIMELINE_BLOCKS;
+static constexpr int kFlashFwdProfileRegTimelineConsumerThreads =
+    3 * 128;
+static constexpr int kFlashFwdProfileRegTimelineBlockMetaCount = 4;
+static constexpr int kFlashFwdProfileRegTimelineBase =
+    kFlashFwdProfileTimelineBase + kFlashFwdProfileTimelineClockCount;
+static constexpr int kFlashFwdProfileRegTimelineBlockClockCount =
+    kFlashFwdProfileRegTimelineBlockMetaCount +
+    kFlashFwdProfileRegTimelineMaxSteps *
+    kFlashFwdProfileRegTimelineConsumerThreads *
+    kFlashFwdProfileRegTimelineEventCount;
+static constexpr int kFlashFwdProfileRegTimelineClockCount =
+    kFlashFwdProfileRegTimelineMaxBlocks *
+    kFlashFwdProfileRegTimelineBlockClockCount;
+static constexpr int kFlashFwdProfileClockCount =
+    kFlashFwdProfileRegTimelineBase +
+    kFlashFwdProfileRegTimelineClockCount;
+
+constexpr int flash_fwd_profile_timeline_offset(int actor, int step, int event) {
+    return ((actor * kFlashFwdProfileTimelineMaxSteps + step) *
+            kFlashFwdProfileTimelineEventCount) + event;
+}
+
+constexpr int flash_fwd_profile_reg_timeline_meta_offset(int block_slot, int field) {
+    return block_slot * kFlashFwdProfileRegTimelineBlockClockCount + field;
+}
+
+constexpr int flash_fwd_profile_reg_timeline_offset(int block_slot, int slot,
+                                                    int thread, int event) {
+    return block_slot * kFlashFwdProfileRegTimelineBlockClockCount +
+           kFlashFwdProfileRegTimelineBlockMetaCount +
+           ((slot * kFlashFwdProfileRegTimelineConsumerThreads + thread) *
+            kFlashFwdProfileRegTimelineEventCount) + event;
+}
+
+constexpr int flash_fwd_profile_reg_timeline_capture_count(int k_tiles) {
+    int const steady_count = k_tiles > 1 ? k_tiles - 1 : 0;
+    return steady_count < kFlashFwdProfileRegTimelineMaxSteps
+        ? steady_count
+        : kFlashFwdProfileRegTimelineMaxSteps;
+}
+
+constexpr int flash_fwd_profile_reg_timeline_first_step(int k_tiles) {
+    int const steady_count = k_tiles > 1 ? k_tiles - 1 : 0;
+    int const capture_count = flash_fwd_profile_reg_timeline_capture_count(k_tiles);
+    return capture_count > 0 ? 1 + (steady_count - capture_count) / 2 : -1;
+}
+
+constexpr int flash_fwd_profile_reg_timeline_slot_for_step(int step, int k_tiles) {
+    int const first_step = flash_fwd_profile_reg_timeline_first_step(k_tiles);
+    int const capture_count = flash_fwd_profile_reg_timeline_capture_count(k_tiles);
+    return step >= first_step && step < first_step + capture_count
+        ? step - first_step
+        : -1;
+}
