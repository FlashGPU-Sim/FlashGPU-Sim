.version 9.2
.target sm_100a
.address_size 64

.visible .entry vector_literal_valid()
{
  .local .align 16 .b8 buf[16];
  .reg .b32 %r<3>;
  .reg .f32 %f<2>;
  .reg .b64 %rd<2>;
  mov.u64 %rd1, buf;
  mov.b32 %r1, 1;
  mov.b32 %r2, 2;
  mov.f32 %f1, 1.0;
  st.local.v2.b32 [%rd1], {0, 0};
  st.local.v2.b32 [%rd1], {%r1, 0};
  st.local.v2.b32 [%rd1], {0, %r1};
  st.local.v2.b32 [%rd1], {%r1, %r2};
  st.local.v4.b32 [%rd1], {0, %r1, 0, %r2};
  st.local.v2.f32 [%rd1], {%f1, 2.0};
  st.local.v2.f64 [%rd1], {1.0, 0d4000000000000000};
  ret;
}
