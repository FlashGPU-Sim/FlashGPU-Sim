# GPGPU-Sim Test Configuration

# Test execution settings
TEST_TIMEOUT=3600         # Test timeout in seconds
TEST_VERBOSE=1            # Verbose output (0=quiet, 1=normal, 2=verbose)
TEST_PARALLEL=1           # Enable parallel test execution

# Memory settings
TEST_MAX_MEMORY=2G        # Maximum memory per test

# Coverage settings (for future use)
ENABLE_COVERAGE=0         # Enable code coverage collection
COVERAGE_OUTPUT_DIR=coverage

# Specific test configurations
BASIC_TEST_ITERATIONS=100
MBARRIER_TEST_THREADS=4
PERFORMANCE_TEST_DURATION=10

# Debug settings
DEBUG_TESTS=0             # Enable debug mode for tests
PRINT_TEST_OUTPUT=1       # Print individual test outputs