# functional simulator specification
# SM90_H200_CLUSTER16x8 — full-chip GPC-packed NVIDIA H200 for cycle calibration.
#
# Naming: CLUSTERmxn → m = enabled SMs per GPC, n = GPCs.
#   8 GPCs × 16 SMs = 128 SMs (uniform 16-SM GPC; product H200 is 132).
# Clocks / L1 / L2 / HBM match SM90_H200 (job 2034797). Fabric on.
# Published B6 cycle numbers use this config. Not SM90_H200_REDUCED_CLUSTER16x2.
#
# Hardware reference (same GH100 die as H100 SXM5 / product floorsweep):
#   - 8 GPCs, 66 TPCs, 2 SMs/TPC → 132 SMs product; this preset is 8×16 = 128
#   - L2: 50 MiB (driver reports ~60 MiB on H200 NVL; keep 50 MiB model)
#   - Memory: 141 GB HBM3e class (H200 NVL ~143 GiB visible)
#   - Compute capability 9.0 (sm_90 / sm_90a)
#
# Latency knobs calibrated from real H200 NVL run (job 2034797, suite all,
# samples=48). Source log: H200_profiling/output-2034797-H200Profiling.txt
# (complete CSV through tma_mc / mma / wgmma / dsm). Note: GPU was not fully
# idle (co-resident python ~24 GiB) — DRAM RTT may be optimistic; HBM peak BW
# still ~2.9 TB/s copy.

-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 90

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
# Calibrated: kernel_launch_est_sm_cycles median ≈ 8266 @ 1781 MHz SM
-gpgpu_kernel_launch_latency 8270
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 9
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
# Full-chip GPC packing for B6 calibration (docs/cluster_noc/calibration.md).
# Product H200 ≈ 16.5 SMs/GPC; uniform 16 enabled SMs on 3 CPCs × 6 slots (2 PG'd).
-gpgpu_n_clusters 8
-gpgpu_n_cores_per_cluster 16
-gpgpu_num_gpcs 8
-gpgpu_num_sms_per_gpc 16
-gpgpu_dsm_cpcs_per_gpc 3
# Same HBM stack / controller count as H100 SXM (6 stacks modeled as 80 channels).
-gpgpu_n_mem 80
-gpgpu_n_sub_partition_per_mchannel 2

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
# H200 NVL job 2034797: prop.clockRate=1785 MHz, observed SM≈1781 MHz,
# prop.memoryClockRate=3201 MHz (HBM3e). Tie ICNT/L2 to core until measured.
-gpgpu_clock_domains 1785:1785:1785:3201

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 90

-gpgpu_shader_core_pipeline 1536:32
-gpgpu_shader_cta 24
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE,ID_OC_TMA,OC_EX_TMA,ID_OC_CP_ASYNC,OC_EX_CP_ASYNC
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4,4,4,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
-gpgpu_num_tma_units 1
-gpgpu_num_cp_async_units 1
-gpgpu_cp_async_max_inflight 256
-gpgpu_cp_async_request_width 4
-gpgpu_cp_async_response_width 4
-gpgpu_cp_async_request_granularity 128
# Calibrated: cp_async_wait_empty median=15 (empty wait_group 0)
-gpgpu_cp_async_wait_release_latency 15
# Max in-flight TMA mem_fetch requests per SM (0=unlimited)
-gpgpu_tma_max_inflight 384
-gpgpu_tma_tx_quota 48
# Coalesce eligible TMA sectors into 128-byte requests.
-gpgpu_tma_request_granularity 128
# TMA OOB policy (from H100 reverse engineering; same Hopper TMA):
#   reads  send OOB fill requests through L2 and zero-fill after response
#   writes skip OOB L2/write requests
-gpgpu_tma_oob_l2_traffic 1
# CTA load balancing: cap CTAs per core to ceil(total_ctas / n_cores)
-gpgpu_cta_load_balance 1
# Calibrated pure mbarrier (no TMA): arrive median=6; trywait success=43
# (arrive.expect_tx(0)+wait e2e median=71 — not used for pure knobs)
-gpgpu_mbarrier_arrive_latency 6
-gpgpu_mbarrier_trywait_latency 43

# Intra-cluster NoC / DSM fabric (docs/cluster_noc/knobs.md, calibration.md).
# H200_profiling output-2046238: DSM local~37, remote RTT~193, hop~(193-37)/2≈78,
# stride_ratio~1.001. TMA mcast−unicast e2e ~+135. Fabric is the timing model.
# Do not use -gpgpu_dsm_bytes_per_cycle as the bandwidth model (keep 0).
-gpgpu_cluster_noc_enable 1
-gpgpu_dsm_enable 1
-gpgpu_dsm_local_latency 37
-gpgpu_dsm_remote_latency 78
-gpgpu_dsm_latency_matrix_file configs/SM90_H200_CLUSTER16x8/dsm_latency_matrix_16.csv
-gpgpu_dsm_bytes_per_cycle 0
-gpgpu_shmem_bytes_per_cycle 0
-gpgpu_dsm_store_immediate 0
-gpgpu_tma_mcast_enable_timing 1
-gpgpu_tma_mcast_hop_latency 135
-gpgpu_tma_mcast_use_dsm_matrix 0
-gpgpu_tma_mcast_bytes_per_cycle 0
-gpgpu_tma_mcast_mbar_after_data 1
-gpgpu_mbarrier_remote_hop_latency 0
-gpgpu_mbarrier_cluster_enable 1
# Fabric knobs (defaults; B6e may refit shaper / ACK / base_latency). measured/inferred.
-gpgpu_dsm_flit_payload_bytes 32
-gpgpu_dsm_lanes_per_cpc 4
-gpgpu_dsm_gx_planes 2
-gpgpu_dsm_shaper skip_mod
-gpgpu_dsm_shaper_period 3
-gpgpu_dsm_shaper_index sm_id
-gpgpu_dsm_request_vc_flits 64
-gpgpu_dsm_response_vc_flits 64
-gpgpu_dsm_ejection_vc_flits 64
-gpgpu_dsm_max_outstanding_per_sm 16
-gpgpu_dsm_ack_coalesce_threshold 4
-gpgpu_dsm_ack_timeout_cycles 64

# Instruction latencies and initiation intervals
# INT <ADD,MAX,MUL,MAD,DIV,SHFL>; FP/DP <ADD,MAX,MUL,MAD,DIV>
# ADD/MUL differential → 0 → use MAD=4. DIV from differential chain (+renorm).
# SHFL probe reported 474 (artifact) → keep 14.
-ptx_opcode_latency_int 4,4,4,4,64,14
-ptx_opcode_initiation_int 1,1,1,1,4,4
# FP: pure div.rn median=37 (prefer over safe+renorm 42). Old 466 was denorm path.
-ptx_opcode_latency_fp 4,4,4,4,37
-ptx_opcode_initiation_fp 1,1,1,1,4
# DP: add/mul/fma=8, div=110
-ptx_opcode_latency_dp 8,8,8,8,110
-ptx_opcode_initiation_dp 1,1,1,1,8
# SFU: rcp=45, ex2=27 → rcp as representative
-ptx_opcode_latency_sfu 45
-ptx_opcode_initiation_sfu 4
# mma latency and initiation following tensor_mma.h:
# tensor[0]: m16n8k16fp16 and default value for unsupported instructions
# tensor[1,2,3]: m16n8k8tf32, m16n8k32int8, m16n8k8fp16
# tensor[4,5,6]: m16n8k8bf16, m16n8k4tf32, m16n8k16int8
# Calibrated [0]=f16 m16n8k16, [1]=tf32 m16n8k8, [2]=s8 m16n8k32 → all 29
-ptx_opcode_latency_tensor 29,29,29,32,32,32,19
# Initiation: ILP-4 f16 gap≈112 is not SM throughput; keep issue-gap proxy 16
-ptx_opcode_initiation_tensor 16,16,16,32,32,32,19
# WGMMA calibrated on m64n16k16 (tuple index n16 → fields [1]):
#   SS issue=11, wait/completion=51; RS issue=19, wait=41
# Fields: <m64n8,m64n16,m64n32,m64n64> — unmeasured N scaled from n16 for now.
-ptx_opcode_latency_wgmma_ss 11,11,11,11
-ptx_opcode_initiation_wgmma_ss 11,11,11,11
-ptx_opcode_completion_wgmma_ss 51,51,51,51
-ptx_opcode_latency_wgmma_rs 19,19,19,19
-ptx_opcode_initiation_wgmma_rs 19,19,19,19
-ptx_opcode_completion_wgmma_rs 41,41,41,41
# TODO(latency): int WGMMA completion not remeasured on H200
-ptx_opcode_completion_wgmma_int_ss 64,64,64,64
-ptx_opcode_completion_wgmma_int_rs 62,62,62,61
-ptx_opcode_compute_throughput_wgmma 4096,2048,8192,8192,65536
-gpgpu_wgmma_issue_chain_ss 7,0,4,20,64
-gpgpu_wgmma_issue_chain_rs 7,0,3,13,64
# TMA issue-only median=68. Multicast mask e2e ≈ unicast on H200 (free path
# today in sim; tma_mc deltas ≈ −20…−40 — do not add extra hop latency yet).
-ptx_opcode_latency_tma 68
-ptx_opcode_initiation_tma 68
# cp.async: pure single-issue gap=112; saturated burst32=39 as initiation
-ptx_opcode_latency_cp_async 112
-ptx_opcode_initiation_cp_async 39
-ptx_opcode_latency_cp_async_commit 2
-ptx_opcode_initiation_cp_async_commit 2
-ptx_opcode_latency_cp_async_wait 15
-ptx_opcode_initiation_cp_async_wait 15

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 16
-gpgpu_operand_collector_num_in_ports_gen 16
-gpgpu_operand_collector_num_out_ports_gen 16
# register banks
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 4

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,32:0,32
# Calibrated: l1_load_latency median=39 (ld.global.ca small footprint)
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
# Hopper SM shared memory (same as H100 product SM)
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 135168
-gpgpu_max_dynamic_smem_prefer_occupancy_carveout 1
-gpgpu_shmem_per_block 232448
# Calibrated: smem_load_latency median=30 (pointer chase)
-gpgpu_smem_latency 30
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 90

# L2 cache
# Experimental: model 80 dual-port L2 slices as 160 single-request slices.
# Keep total L2 capacity at 50 MiB: 128 sets * 128 B * 20 ways * 160 slices.
-gpgpu_cache:dl2 S:128:128:20,L:B:m:L:P,A:512:96,32:0,64
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 2

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:32:32,32
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
-icnt_use_voq 1

# memory partition latency config
# Job 2034797:
#   multi_sm_l2_p50 ≈ 286 → l2_rop
#   far_l2_extra ≈ max(p90−p10=22.8, offset_spread=20) → 23
#   DRAM residual: cold miss not isolated under co-resident load (dram chase
#   median≈285 ≈ L2); keep residual 360 from earlier exclusive-style fit
#   (total miss path ≈ 286+360).
-gpgpu_l2_rop_latency 286
# Coarse Hopper L2 locality model: split SMs and L2 subpartitions into two
# contiguous partitions. Requests from an SM to the other partition pay the
# far-L2 fabric latency charge.
-gpgpu_l2_partition_count 2
-gpgpu_l2_partition_extra_latency 23
-dram_latency 360

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 384

# dram model config
# Same HBM channel geometry as H100; DRAM clock domain models HBM3e (3201 MHz).
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 8
-gpgpu_dram_burst_length 4
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@9;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing
# Bank timings still H100 HBM3 template (not uniquely invertible). Validate
# peak with measured HBM STREAM: copy≈2909, read≈2439, write≈3552 GB/s
# (job 2034797; prop mem clock 3201 MHz).
-gpgpu_dram_timing_opt nbk=16:CCD=2:RRD=3:RCD=12:RAS=28:RP=12:RC=40:CL=12:WL=2:CDLR=3:WR=10:nbkgrp=4:CCDL=2:RTPL=3
-dram_dual_bus_interface 1

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
-trace_enabled 0
-trace_components LIVENESS
-trace_sampling_core 0

# PTX scheduling support (same defaults as SM90_H100).
-gpgpu_ptx_register_allocator 1
-gpgpu_ptx_register_allocator_stats 0
-gpgpu_ptx_reorder 1
# Opt in to auto-extracted SASS PTX-line guidance when the workload provides
# suitable line information.
-gpgpu_ptx_reorder_sass_guided 0

# WGMMA RF pressure model:
# - Normal operand collector reads share a 1024 B/cycle per-SM budget.
# - Pending WGMMA completions inject one accumulator-sized read-equivalent token
#   and drain at 512 B/cycle from the same budget.
# H200 NVL job 2034797: pure SS total≈103 cyc/op vs SS+32 FMA mix≈948 —
# pressure model still useful; byte/cycle budgets kept until dedicated RF fit.
-gpgpu_wgmma_rf_traffic_enable 1
-gpgpu_reg_file_read_bytes_per_cycle 1024
-gpgpu_wgmma_rf_traffic_bytes_per_cycle 512
-gpgpu_wgmma_rf_traffic_share_read_budget 1
-gpgpu_wgmma_rf_traffic_assume_accumulate 0
-gpgpu_wgmma_rf_traffic_include_rs_a 0

# DSM / SM-to-SM: intra-GPC fabric is on (see knobs above).
# Delay-line matrix remains until B-DEPR; BPC is 0 (not the bandwidth model).
# Calibration: docs/cluster_noc/calibration.md.


# Non-power-of-two memory partition hash (same as H100):
# hash to 1024 virtual L2/HBM-bound memory subpartitions and range-reduce to
# the final 160 destinations.
-gpgpu_ipoly_non_power2_balanced 2
-gpgpu_ipoly_channel_stable_l2slice 0
