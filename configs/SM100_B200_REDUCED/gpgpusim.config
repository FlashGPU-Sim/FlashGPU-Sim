# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 100

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 5000
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 10
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
-gpgpu_n_clusters 1
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 12

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
# Match SM100_B200; this one-SM config is for functional testing only.
-gpgpu_clock_domains 1080:1080:1155:3996

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 100

# B200 supports 64 resident warps (2048 threads) per SM.
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 24
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE,ID_OC_TMA,OC_EX_TMA,ID_OC_CP_ASYNC,OC_EX_CP_ASYNC
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4,4,4,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
# Match the full B200 model's peak-clock-derived 30,947 dense FP4
# FLOP/cycle/SM hardware throughput.
-ptx_opcode_compute_throughput_tcgen05_mxf4 30947
# kind::mxf8f6f4 stays on the FP8-class Tensor Core rate even when either
# operand selects a padded FP4/FP6 element type.
-ptx_opcode_compute_throughput_tcgen05_mxf8f6f4 15474
-gpgpu_num_tma_units 1
-gpgpu_num_cp_async_units 1
# Match the full B200 model's per-type 32-byte request granularity and local
# request/response service widths.
-gpgpu_tma_request_granularity 32
-gpgpu_tma_request_width 4
-gpgpu_tma_response_width 4
-gpgpu_cp_async_request_granularity 32
-gpgpu_cp_async_request_width 4
-gpgpu_cp_async_response_width 4
# Max in-flight TMA mem_fetch requests per SM (0=unlimited)
-gpgpu_tma_max_inflight 0

# Instruction latencies and initiation intervals
-ptx_opcode_latency_int 4,4,4,4,21,14
-ptx_opcode_initiation_int 1,1,1,1,2,4
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 1,1,1,1,2
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 28
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tensor 34,34,20,20,20,20,20
-ptx_opcode_initiation_tensor 34,34,20,20,20,20,20
# TMA (cp.async.bulk) issue gap: elect + cp.async.bulk ≈ 33 cycles from microbench
-ptx_opcode_latency_tma 33
-ptx_opcode_initiation_tma 33

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# register banks
-gpgpu_num_reg_banks 8
-gpgpu_reg_file_port_throughput 2

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache 
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x 
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,16:0,32
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_n_ldst_response_buffer_size 4
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472
-gpgpu_shmem_per_block 49152
-gpgpu_shmem_per_block_optin 232448
-gpgpu_smem_latency 29
# shared memory bankconflict detection 
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 100

# Match the full B200 topology and capacity abstraction: 192 L2 instances *
# 256 sets * 128 B * 21 ways = 132,120,576 B (126 MiB).
-gpgpu_cache:dl2 S:256:128:21,L:B:m:L:P,A:192:4,32:0,32
# Match the full model's independent lookup, data, and fill widths of three
# 32 B sector work packages per L2 instance/tick. These are current model
# values, not claims about the physical B200 port organization.
-gpgpu_l2_multi_issue_port_model 1
-gpgpu_l2_lookup_sectors_per_cycle 3
-gpgpu_l2_data_port_sectors_per_cycle 3
-gpgpu_l2_fill_port_sectors_per_cycle 3
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 0
-gpgpu_non_power2_l2_slice_mapping 1

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
-icnt_request_input_sectors_per_cycle 4
-icnt_request_output_sectors_per_cycle 4
-gpgpu_l2_request_ingress_sectors_per_cycle 4
-gpgpu_l2_response_egress_sectors_per_cycle 4
-icnt_reply_input_sectors_per_cycle 4
-icnt_reply_output_sectors_per_cycle 4
-gpgpu_cluster_response_ingress_sectors_per_cycle 4
-gpgpu_cluster_response_dispatch_sectors_per_cycle 4
-gpgpu_ldst_request_width 4
-gpgpu_ldst_response_sectors_per_cycle 4

# memory partition latency config
-gpgpu_l2_rop_latency 187
# Match the full model's candidate ready ROP-delay output service width.
-gpgpu_l2_rop_delay_output_sectors_per_cycle 3
# This fixed latency is still a placeholder. The aggregate service model below
# is retained to exercise the same per-partition HBM path as SM100_B200.
-dram_latency 254

# dram sched config
-gpgpu_simple_dram_model 1
# Match SM100_B200's per-partition service rate. Because this reduced config has
# only one SM, its aggregate workload throughput is not a B200 performance
# prediction.
-gpgpu_simple_dram_service_rate_num 15
-gpgpu_simple_dram_service_rate_den 4
-gpgpu_simple_dram_max_inflight 4096
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# dram model config
-gpgpu_n_mem_per_ctrlr 1
# One simulator DRAM transfer atom is one 32-byte sector.
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing (retained for detailed-model fallback; bypassed while the simple
# aggregate service model above is enabled)
-gpgpu_dram_timing_opt nbk=16:CCD=4:RRD=12:RCD=24:RAS=55:RP=24:RC=78:CL=24:WL=8:CDLR=10:WR=24:nbkgrp=4:CCDL=6:RTPL=4
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14 
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
-trace_enabled 0
-trace_components WIP
-trace_sampling_core 0
