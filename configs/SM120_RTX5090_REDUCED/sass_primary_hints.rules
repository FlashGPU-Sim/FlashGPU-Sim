# Primary SASS hints for SASS-PTX-line guided reorder.
# Scope: RTX 5090 / sm_120a, CUDA 12.8.

[metadata]
rule_version = 1
arch = sm_120a
gpu = RTX5090
toolchain = cuda_12_8
nvcc_version = 12.8.93
nvdisasm_version = 12.8.90

[primary_opcode]
ldmatrix.sync.aligned.x4.m8n8.shared.b16 = LDSM.16.M88.4
ldmatrix.sync.aligned.x4.trans.m8n8.shared.b16 = LDSM.16.MT88.4
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 = HMMA.16816.F32

# Softmax / normalization path.
max.ftz.f32 = FMNMX.FTZ
ex2.approx.ftz.f32 = MUFU.EX2
rcp.approx.ftz.f32 = MUFU.RCP
lg2.approx.ftz.f32 = MUFU.LG2
add.ftz.f32 = FADD.FTZ, FFMA.FTZ
mul.ftz.f32 = FMUL.FTZ, FFMA.FTZ
sub.ftz.f32 = FADD.FTZ, FFMA.FTZ
fma.rn.ftz.f32 = FFMA.FTZ
cvt.rn.f16x2.f32 = F2FP.F16.F32.PACK_AB
shfl.sync.bfly.b32 = SHFL.BFLY
setp.eq.ftz.f32 = FSETP.NEU.FTZ.AND, FSETP.NE.FTZ.AND
setp.equ.ftz.f32 = FSETP.NEU.FTZ.AND, FSETP.NE.FTZ.AND

[attached_opcode_allowlist]
# These were observed as non-primary SASS sharing a PTX line with one of the
# primary opcodes above. They should not become guide anchors.
ldmatrix.sync.aligned.x4.m8n8.shared.b16 = UIADD3, IADD3
ldmatrix.sync.aligned.x4.trans.m8n8.shared.b16 = UIADD3, MOV, IADD3
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 = UIADD3, NOP, MOV, LDL.LU, STL
max.ftz.f32 = MOV, UIADD3, STL, STL.64
ex2.approx.ftz.f32 = MOV, UIADD3, STL, LDL.LU
add.ftz.f32 = MOV, LDL.LU, STL, UIADD3
mul.ftz.f32 = MOV, LDL.LU, STL, LDCU, UIADD3
sub.ftz.f32 = MOV, STL
fma.rn.ftz.f32 = LDC, MOV, BSSY.RECONVERGENT
cvt.rn.f16x2.f32 = MOV, STL, LDL.LU, UIADD3
shfl.sync.bfly.b32 = STL

[policy]
unknown_arch = fatal
toolchain_mismatch = fatal
missing_primary_rule = fatal
zero_primary_candidate = fatal
multiple_primary_candidates_without_explicit_hint = fatal
unexpected_attached_opcode = fatal
fallback = disabled
