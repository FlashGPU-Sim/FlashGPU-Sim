# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 120

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 5500
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 12
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
-gpgpu_n_clusters 170
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 3

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
# NCU measured ~2317 MHz LTS at a 2580 MHz core lock. Fixed-clock model;
# loaded hardware can downclock LTS to ~2225 MHz.
-gpgpu_clock_domains 2580:2580:2317:14001

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 120

-gpgpu_shader_core_pipeline 1536:32
-gpgpu_shader_cta 24
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE,ID_OC_TMA,OC_EX_TMA,ID_OC_CP_ASYNC,OC_EX_CP_ASYNC,ID_OC_TENSOR_MAP,OC_EX_TENSOR_MAP
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4,4,4,4,4,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
-gpgpu_num_tma_units 1
-gpgpu_num_cp_async_units 1
-gpgpu_cp_async_max_inflight 192
-gpgpu_cp_async_request_width 4
-gpgpu_cp_async_response_width 4
-gpgpu_cp_async_wait_release_latency 5
-gpgpu_num_tensormap_units 1
# TMA front-end transaction slots per SM. New TMA copies backpressure warp
# issue while all slots are occupied; bulk commit/wait control operations bypass
# this limit so they can retire existing transactions.
-gpgpu_tma_transaction_slots 16
# Hardware sustains 30.816 B/core-cycle across an 845.7-cycle DRAM round trip,
# proving capacity for at least 814 tracked 32-byte requests per SM. Use 1024
# as a provisional finite aggregate upper bound pending a direct capacity
# measurement. This is not a per-source quota or arbitration mechanism.
-gpgpu_tma_max_inflight 1024
# TMA request packet granularity.
-gpgpu_tma_request_granularity 32
# A four-warp RTX 5090 probe retaining elect/predicate/bar.sync in its control
# measures 164--179 extra cycles per tensor-map load issue before the issuing
# warp reaches the following barrier. Two issues measure +343 cycles versus
# +8 in the legacy model. This issue-side warp occupancy is separate from TMA
# transaction completion and does not alter memory-service latency.
-gpgpu_tma_issue_to_next_instruction_latency 168
# Send OOB fill requests through L2 (models real HW: TMA sends full-tile
# requests unconditionally, zero-fills after response)
-gpgpu_tma_oob_l2_traffic 1
# CTA load balancing: cap CTAs per core to ceil(total_ctas / n_cores)
-gpgpu_cta_load_balance 1
# Four-warp CTA bar.sync chains recur every 20 core cycles on RTX 5090.
-gpgpu_barrier_release_latency 20
# mbarrier arrive_tx shared memory write latency (cycles)
-gpgpu_mbarrier_arrive_latency 29
# RTX 5090 no-hint try_wait complete and incomplete dependency chains both
# have a 34-cycle issue-to-predicate-ready slope.
-gpgpu_mbarrier_trywait_latency 34
-gpgpu_mbarrier_predicate_latency 34
# Delayed-producer probes measure 127/124 cycles from pre-arrive to wait
# return on RTX 5090; phase wakeup 110 gives 121/122 (default 0 gives 11/11).
-gpgpu_mbarrier_phase_wakeup_latency 110

# RTX 5090 dependent ALU chains expose opcode latency before physical
# writeback; SELP and SETP-to-predicate-guard both measure 5 cycles.
-gpgpu_alu_scoreboard_forwarding 1

# Instruction latencies and initiation intervals
# RTX 5090 dependent SELP and SETP-to-predicate-guard chains both measure
# five core cycles per step.
-ptx_opcode_latency_predicate 5
-ptx_opcode_latency_int 4,4,4,4,21,29
-ptx_opcode_initiation_int 1,1,1,1,2,4
# A dependent SHFL chain measures 29 cycles per instruction. MIO throughput
# probes motivate a two-cycle aggregate service interval across the SM; the
# finite queue is a run-ahead approximation rather than a physical-depth claim.
-gpgpu_mio_issue_interval 2
-gpgpu_mio_issue_queue_depth 16
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 1,1,1,1,2
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 28
-ptx_opcode_initiation_sfu 8
# mma latency and initiation following tensor_mma.h:
# tensor[0]: m16n8k16fp16 and default value for unsupported instructions
# tensor[1,2,3]: m16n8k8tf32, m16n8k32int8, m16n8k8fp16
# tensor[4,5,6]: m16n8k8bf16, m16n8k4tf32, m16n8k16int8
-ptx_opcode_latency_tensor 34,32,16,32,32,32,16
-ptx_opcode_initiation_tensor 32,32,16,32,32,32,16
# TMA (cp.async.bulk) issue gap: elect + cp.async.bulk ≈ 33 cycles from microbench
-ptx_opcode_latency_tma 32
-ptx_opcode_initiation_tma 32
-ptx_opcode_latency_cp_async 7
-ptx_opcode_initiation_cp_async 7
-ptx_opcode_latency_cp_async_commit 7
-ptx_opcode_initiation_cp_async_commit 7
-ptx_opcode_latency_cp_async_wait 5
-ptx_opcode_initiation_cp_async_wait 5
# Tensormap descriptor timing:
# <replace,cp_fenceproxy,fence.proxy.tensormap>
-ptx_opcode_latency_tensormap 11,448,79
-ptx_opcode_initiation_tensormap 1,1,1

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 16
-gpgpu_operand_collector_num_in_ports_gen 16
-gpgpu_operand_collector_num_out_ports_gen 16
# register banks
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 4

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100
-gpgpu_unified_l1d_size 128
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,32:0,32
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
-gpgpu_shmem_size 102400
-gpgpu_shmem_sizeDefault 102400
-gpgpu_shmem_per_block 49152
-gpgpu_shmem_per_block_optin 101376
-gpgpu_smem_latency 29
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_load_min_dispatch_cycles 2
# Conflict-free LDS and STS microbenchmarks motivate a four-cycle same-warp
# recurrence and a two-cycle aggregate shared-store dispatch service time.
-gpgpu_shmem_load_issue_interval 4
-gpgpu_shmem_store_min_dispatch_cycles 2
-gpgpu_shmem_store_issue_interval 4
-gpgpu_ldmatrix_min_dispatch_cycles 4
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 120

# L2 cache
# Model 48 LTS instances: 16 controllers x 3 slices, 2 MiB per slice.
# 256 sets x 128 B x 64 ways x 48 = 96 MiB. Associativity is a capacity
# modeling choice, not a hardware measurement. NCU device L2S=96 remains
# unresolved; lts counter aggregation reports 48 instances.
-gpgpu_cache:dl2 S:256:128:64,L:B:m:L:P,A:256:96,32:0,32
# NCU reference peaks, in 32 B sectors per LTS cycle. Array service includes
# fills and hit/eviction data; it is not the network read-return width.
-gpgpu_l2_multi_issue_port_model 1
-gpgpu_l2_lookup_sectors_per_cycle 2
-gpgpu_l2_data_port_sectors_per_cycle 4
-gpgpu_l2_fill_port_sectors_per_cycle 1
-gpgpu_l2_shared_data_array 1
-gpgpu_l2_rop_delay_output_sectors_per_cycle 2
-gpgpu_l2_request_ingress_sectors_per_cycle 2
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 0
# Independent 16-way IPOLY channel hash and balanced three-slice mapping.
-gpgpu_memory_partition_indexing 0
-gpgpu_non_power2_l2_channel_indexing 2
-gpgpu_non_power2_l2_slice_mapping 1

# Effective 64 KiB instruction cache with 12 miss entries.
-gpgpu_cache:il1 N:64:128:8,L:R:f:N:L,S:12:32,32
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
# Separate destinations within each input budget: a blocked SM return must
# not hold up responses for other SMs after reducing to 48 L2 endpoints.
# This is a transport modeling assumption; credits and port widths stay bounded.
-icnt_use_voq 1
-icnt_multi_grant_request 1
-icnt_multi_grant_reply 1
# Carry two sector requests to each L2 endpoint without a legacy 1-packet
# bottleneck. This transport width is an effective model, not a measured
# internal router port. SM request input retains its existing behavior.
-icnt_request_output_sectors_per_cycle 2
# Hot-read NCU traffic exceeds 1 sector/LTS cycle: use the minimum integer
# return width of 2 (in ICNT cycles), independently of the 4-sector array.
-gpgpu_l2_response_egress_sectors_per_cycle 2
-icnt_reply_input_sectors_per_cycle 2
# NCU SM read-return reference is 1 sector/core cycle.
-icnt_reply_output_sectors_per_cycle 1
-gpgpu_cluster_response_ingress_sectors_per_cycle 1
-gpgpu_cluster_response_dispatch_sectors_per_cycle 1

# memory partition latency config
# Retain the L2 hit calibration with uniform DRAM service.
-gpgpu_l2_rop_latency 322
# Effective miss-path delay calibrated with zero-hit dependent loads.
# At 2580/14001 MHz, 128-B/4-KiB-stride probes measure about 871 hardware
# core cycles; simple DRAM gives 844 (about -3%). Not intrinsic chip latency.
-dram_latency 500

# dram sched config
# Uniform DRAM service: 16 controllers * 32 B * 14001 MHz / 4 = 1792.128 GB/s.
-gpgpu_simple_dram_model 1
-gpgpu_simple_dram_service_rate_num 1
-gpgpu_simple_dram_service_rate_den 4
# Nominal bandwidth target for validation; does not control simulator timing.
-gpgpu_dram_expected_bandwidth_TBp 1.792
# At 500 core cycles, the fixed-delay bandwidth product is 678.34 sectors
# per controller. Round ceil(product)+4 up to four requests: 684.
# Three 256-entry sector MSHRs provide capacity beyond this delay minimum.
# The inflight cap and MSHR count are capacity assumptions, not measured depths.
-gpgpu_simple_dram_max_inflight 684
# Legacy detailed-scheduler settings do not determine the explicit cap above.
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 384

# dram model config
-gpgpu_n_mem_per_ctrlr 1
# In simple mode, bus width * burst length defines one 32-byte service atom.
-gpgpu_dram_buswidth 4
-gpgpu_dram_burst_length 8
-dram_data_command_freq_ratio 4
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing
-gpgpu_dram_timing_opt nbk=16:CCD=4:RRD=12:RCD=24:RAS=55:RP=24:RC=78:CL=24:WL=8:CDLR=10:WR=24:nbkgrp=4:CCDL=6:RTPL=4
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
-trace_enabled 0
-trace_components LIVENESS
-trace_sampling_core -1

# PTX scheduling support.
-gpgpu_ptx_register_allocator 1
-gpgpu_ptx_register_allocator_stats 0
-gpgpu_ptx_reorder 1

# Hardware-level SASS PTX-line guide hints.
# When enabled, the simulator auto-extracts full SASS PTX-line info into
# sass_ptxline/ and auto-loads the single .rules file in this config/run
# directory.
-gpgpu_ptx_reorder_sass_guided 1

# Instruction hierarchy used by the RTX 5090 calibration working point.
-gpgpu_perfect_inst_cache 0
-gpgpu_icache_address_scale 2
-gpgpu_icache_prefetch_enable 1
-gpgpu_icache_prefetch_streams 1
-gpgpu_icache_prefetch_depth 4
-gpgpu_icache_prefetch_issue_width 1
-gpgpu_icache_gcc_preload_lines 512
-gpgpu_icache_gcc_hit_latency 16
