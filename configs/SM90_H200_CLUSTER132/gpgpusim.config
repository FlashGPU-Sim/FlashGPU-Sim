# functional simulator specification
# SM90_H200_CLUSTER132 — product-scale GPC-packed NVIDIA H200 NVL.
#
# inferred packing (not a measured SMID map): 6 GPCs × 16 SMs + 2 GPCs × 18 SMs
# = 132 SMs. CPC = 3×6 slots; 16-SM GPC has 2 PG'd slots.
# Default full-chip packing for published cycle numbers. Fabric on.
# Compute/L1 defaults follow SM90_H200; HBM/L2 geometry follows the H200 NVL
# product brief rather than the older H100-width SM90_H200 memory model.
#
# Hardware reference (GH100 / H200 NVL):
#   - 8 GPCs, 132 SMs (cudaDeviceProp.multiProcessorCount)
#   - L2 model: 188 slices × 320 KiB = 58.75 MiB
#   - Memory: 141 GB HBM3e, 6016-bit bus, boost 1785 MHz, mem 3201 MHz
#   - Compute capability 9.0; max 2048 threads / 32 blocks per SM (CUDA CC 9.0)
#
# Calibration-derived latency/throughput knobs below use accepted rows from
# H200 job 2119329 where noted. That job is not a final pass because its 4096^3
# GEMM case failed; unmeasured fields use the H100 same-Hopper baseline.

-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 90

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
# H200 job 2119329: 4.896 us median at 1776.69 MHz = 8698.67 cycles.
-gpgpu_kernel_launch_latency 8700
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 9
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
# Product packing: inferred 6×16 + 2×18. Scalar sms-per-gpc is the max (18).
-gpgpu_n_clusters 8
-gpgpu_n_cores_per_cluster 18
-gpgpu_num_gpcs 8
-gpgpu_num_sms_per_gpc 18
-gpgpu_gpc_sms 16,16,16,16,16,16,18,18
-gpgpu_dsm_cpcs_per_gpc 3
# Derived from the NVIDIA H200 NVL product brief: 6016-bit memory bus /
# (8-byte simulated channel × 8 bits/byte) = 94 channels. With the 3201 MHz
# datasheet clock and DDR ratio 2, modeled peak is 4.814 TB/s (brief: 4.813).
-gpgpu_n_mem 94
-gpgpu_n_sub_partition_per_mchannel 2

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
# H200 NVL product brief: boost=1785 MHz and memory=3201 MHz (HBM3e).
# Job 2119329 did not measure ICNT/L2 clocks; retain the H100 Hopper baseline
# for those two domains until a dedicated H200 measurement is available.
-gpgpu_clock_domains 1785:1700:1700:3201

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 90

# CUDA CC 9.0 specification: 2048 threads / 64 warps / 32 blocks per SM.
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE,ID_OC_TMA,OC_EX_TMA,ID_OC_CP_ASYNC,OC_EX_CP_ASYNC
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4,4,4,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
-gpgpu_num_tma_units 1
-gpgpu_num_cp_async_units 1
-gpgpu_cp_async_max_inflight 256
-gpgpu_cp_async_request_width 4
-gpgpu_cp_async_response_width 4
-gpgpu_cp_async_request_granularity 128
# H200 job 2119329 did not isolate wait release; H100 same-Hopper baseline.
-gpgpu_cp_async_wait_release_latency 5
# Max in-flight TMA mem_fetch requests per SM (0=unlimited)
-gpgpu_tma_max_inflight 384
-gpgpu_tma_tx_quota 48
# Coalesce eligible TMA sectors into 128-byte requests.
-gpgpu_tma_request_granularity 128
# TMA OOB policy (from H100 reverse engineering; same Hopper TMA):
#   reads  send OOB fill requests through L2 and zero-fill after response
#   writes skip OOB L2/write requests
-gpgpu_tma_oob_l2_traffic 1
# CTA load balancing: cap CTAs per core to ceil(total_ctas / n_cores)
-gpgpu_cta_load_balance 1
# H200 job 2119329: pure arrive median 6, successful pure try-wait median 43.
-gpgpu_mbarrier_arrive_latency 6
-gpgpu_mbarrier_trywait_latency 43
# Candidate bounded no-hint suspension: job 2119329 WaitFalse slope is
# 7755 cycles/op. 4320 ns gives 7712 cycles at 1785 MHz, leaving ~43 cycles
# for release/issue overhead. Validate the matched false chain and GEMM;
# this is a timeout, not the latency of a successful wait. H100 default is 0.
-gpgpu_mbarrier_trywait_default_timeout_ns 4320

# Intra-GPC DSM fabric (docs/cluster_noc/knobs.md, calibration.md).
-gpgpu_dsm_enable 1
-gpgpu_shmem_bytes_per_cycle 0
# H200 job 2119329: robust multicast-minus-unicast median ~=99 cycles.
-gpgpu_tma_multicast_latency 100
-gpgpu_mbarrier_cluster_enable 1
# Fabric knobs are provisional until refitted against job 2119329.
-gpgpu_dsm_flit_payload_bytes 32
-gpgpu_dsm_lanes_per_cpc 4
-gpgpu_dsm_gx_planes 2
-gpgpu_dsm_shaper skip_mod
-gpgpu_dsm_shaper_period 3
-gpgpu_dsm_shaper_index sm_id
-gpgpu_dsm_request_vc_flits 512
-gpgpu_dsm_response_vc_flits 512
-gpgpu_dsm_ejection_vc_flits 512
-gpgpu_dsm_max_outstanding_per_sm 1024
-gpgpu_dsm_ack_coalesce_threshold 64
-gpgpu_dsm_ack_timeout_cycles 64
# Job 2119329 inferred one-way component: 78.18 cycles.
-gpgpu_dsm_base_latency_cycles 78
-gpgpu_dsm_store_visibility_latency_cycles 245
# Job 2119329 TMALoad 256 B/1/4/16 KiB medians fitted together. 1314 +
# ceil(38*bytes/1024), plus the probe's measured 79-cycle instruction/wait
# envelope, predicts every accepted point within 6.32%.
-gpgpu_tma_load_completion_base_cycles 1314
-gpgpu_tma_load_completion_cycles_per_kib 38
# Provisional linear floor fitted to job 2119329 cluster TMA size sweeps.
# 860 + ceil(12*bytes/1024), plus the observed ~76-cycle probe envelope,
# predicts all 16 unicast/multicast E2E targets within 6.12% with multicast=100.
# This is an effective completion floor, not measured HBM or DSM bandwidth;
# actual memory responses must also complete. Validate with GEMM separately.
-gpgpu_tma_cluster_load_completion_base_cycles 860
-gpgpu_tma_cluster_load_completion_cycles_per_kib 12

# Instruction latencies and initiation intervals
# INT <ADD,MAX,MUL,MAD,DIV,SHFL>; FP/DP <ADD,MAX,MUL,MAD,DIV>
# Job 2119329 did not measure INT DIV; field [4] uses the H100 same-Hopper
# baseline. ADD/MUL/MAD are consistent with the accepted hardware slopes.
-ptx_opcode_latency_int 4,4,4,4,21,14
-ptx_opcode_initiation_int 1,1,1,1,2,4
# The shipped G3 cubin lowers dependency-critical PTX add.s64 address work to
# paired IADD3/IMAD.X or LEA/LEA.HI instructions. Job 2119329's matched no-TMA
# n4k/n8k pair also shows insufficient latency hiding at one CTA per SM. Model
# that lowering without changing the measured 32-bit INT ADD/MUL/MAD values.
# Provisional: instruction pairs motivate this test but do not establish a
# factor-two latency/initiation fit; matched controls and GEMM gates are pending.
-ptx_int64_add_lowering_factor 2
# Job 2119329 did not measure FP DIV; field [4] uses the H100 baseline.
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 1,1,1,1,2
# Job 2119329 did not execute DP probes. Use the H100 same-GH100 baseline;
# these values are explicitly not an H200 calibration result.
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
# Provisional old SFU fit; revalidate the representative opcode.
-ptx_opcode_latency_sfu 45
-ptx_opcode_initiation_sfu 4
# mma latency and initiation following tensor_mma.h:
# tensor[0]: m16n8k16fp16 and default value for unsupported instructions
# tensor[1,2,3]: m16n8k8tf32, m16n8k32int8, m16n8k8fp16
# tensor[4,5,6]: m16n8k8bf16, m16n8k4tf32, m16n8k16int8
# Provisional old MMA fits; revalidate with the exact instruction sweep.
-ptx_opcode_latency_tensor 29,29,29,32,32,32,19
# Initiation: ILP-4 f16 gap≈112 is not SM throughput; keep issue-gap proxy 16
-ptx_opcode_initiation_tensor 16,16,16,32,32,32,19
# H200 job 2119329 FP16 shape/group sweeps. Fields are
# <m64n8,m64n16,m64n32,m64n64>; issue uses the steady minimum. SS completion
# is a compute-subtracted tail; RS still needs the same matched validation.
# Keep the separately fitted chain below.
-ptx_opcode_latency_wgmma_ss 4,4,4,4
-ptx_opcode_initiation_wgmma_ss 4,4,4,4
# Job 2119329 SS wait = 43 + N/2 cycles. Compute contributes N/2;
# matched vendor diagnostic observes wait = compute + tail - 3 cycles.
# Thus use a 46-cycle tail, not the measured wait (which double-counts compute).
# N=64/128 validation and independent GEMM acceptance are documented separately.
-ptx_opcode_completion_wgmma_ss 46,46,46,46
-ptx_opcode_latency_wgmma_rs 9,9,9,10
-ptx_opcode_initiation_wgmma_rs 9,9,9,10
-ptx_opcode_completion_wgmma_rs 37,41,49,65
# TODO(latency): int WGMMA completion not remeasured on H200
-ptx_opcode_completion_wgmma_int_ss 64,64,64,64
-ptx_opcode_completion_wgmma_int_rs 62,62,62,61
-ptx_opcode_compute_throughput_wgmma 4096,2048,8192,8192,65536
-gpgpu_wgmma_issue_chain_ss 7,0,4,20,64
-gpgpu_wgmma_issue_chain_rs 7,0,3,13,64
# Job 2119329 measured TMA completion, not the pure instruction issue boundary;
# retain the H100 same-Hopper issue baseline.
-ptx_opcode_latency_tma 32
-ptx_opcode_initiation_tma 32
# H200 job 2119329 issue-scope result: 65 cycles / 16 copies = 4.0625.
-ptx_opcode_latency_cp_async 4
-ptx_opcode_initiation_cp_async 4
# Commit and wait were not isolated by job 2119329; H100 Hopper baselines.
-ptx_opcode_latency_cp_async_commit 7
-ptx_opcode_initiation_cp_async_commit 7
-ptx_opcode_latency_cp_async_wait 5
-ptx_opcode_initiation_cp_async_wait 5

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 16
-gpgpu_operand_collector_num_in_ports_gen 16
-gpgpu_operand_collector_num_out_ports_gen 16
# register banks
-gpgpu_num_reg_banks 16
-gpgpu_reg_file_port_throughput 4

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,32:0,32
# Provisional old L1 fit; job 2119329 did not isolate this config component.
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
# Hopper SM shared memory (same as H100 product SM)
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 135168
-gpgpu_max_dynamic_smem_prefer_occupancy_carveout 1
-gpgpu_shmem_per_block 232448
# Same-Hopper provisional baseline, matching SM90_H200. Revalidate direct
# shared-memory latency; do not infer it by subtracting a DSM pointer chase.
-gpgpu_smem_latency 30
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 90

# L2 cache
# H200 NVL's datasheet-derived 94 channels create 188 single-request slices.
# This geometry models 128 sets * 128 B * 20 ways * 188 = 58.75 MiB L2.
-gpgpu_cache:dl2 S:128:128:20,L:B:m:L:P,A:512:96,32:0,64
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 2

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:32:32,32
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
# Keep the H100 baseline. The bundled real L1I/L1C path helps no-TMA GEMM but
# severely regresses accepted TMA/mbarrier probes; see calibration.md.
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
-icnt_use_voq 1

# memory partition latency config
# Job 2119329 did not isolate the simulator's L2 base component; retain the
# provisional value until the matched simulator probe is compared.
-gpgpu_l2_rop_latency 286
# Coarse Hopper L2 locality model: split SMs and L2 subpartitions into two
# contiguous partitions. Requests from an SM to the other partition pay the
# far-L2 fabric latency charge.
-gpgpu_l2_partition_count 2
# Job 2119329 did not export per-SM/per-offset near/far distributions and did
# not isolate a cold dependent HBM miss. Use H100 baselines, not old H200 fits.
-gpgpu_l2_partition_extra_latency 150
-dram_latency 254

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 384

# dram model config
# H200 NVL geometry is 94 simulated 64-bit channels; clock is 3201 MHz.
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 8
-gpgpu_dram_burst_length 4
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@9;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing
# Bank timings remain the H100 HBM3 template and are provisional. Job 2119329
# constrained bandwidth but did not isolate the timing fields or DRAM residual.
-gpgpu_dram_timing_opt nbk=16:CCD=2:RRD=3:RCD=12:RAS=28:RP=12:RC=40:CL=12:WL=2:CDLR=3:WR=10:nbkgrp=4:CCDL=2:RTPL=3
-dram_dual_bus_interface 1

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
-trace_enabled 0
-trace_components LIVENESS
-trace_sampling_core 0

# PTX scheduling support (same defaults as SM90_H100).
# The optional allocator aliases a live shared-address register in the looped
# TMA issue probe; keep architectural PTX registers distinct for calibration.
-gpgpu_ptx_register_allocator 0
-gpgpu_ptx_register_allocator_stats 0
-gpgpu_ptx_reorder 1
# Opt in to auto-extracted SASS PTX-line guidance when the workload provides
# suitable line information.
-gpgpu_ptx_reorder_sass_guided 0

# WGMMA RF pressure model:
# - Normal operand collector reads share a 1024 B/cycle per-SM budget.
# - Pending WGMMA completions inject one accumulator-sized read-equivalent token
#   and drain at 512 B/cycle from the same budget.
# RF-pressure byte/cycle budgets: inferred, not a dedicated H200 fit.
-gpgpu_wgmma_rf_traffic_enable 1
-gpgpu_reg_file_read_bytes_per_cycle 1024
-gpgpu_wgmma_rf_traffic_bytes_per_cycle 512
-gpgpu_wgmma_rf_traffic_share_read_budget 1
-gpgpu_wgmma_rf_traffic_assume_accumulate 0
-gpgpu_wgmma_rf_traffic_include_rs_a 0

# DSM / SM-to-SM: intra-GPC fabric is on (see knobs above).
# Calibration: docs/cluster_noc/calibration.md.


# Non-power-of-two memory partition hash. 3 = bijective IPOLY-derived
# cyclic rotation (preserves all 188 channel/slice identities on 94x2).
# Values 0/1/2 keep the flash algorithms (H100 uses 2). Not a measured
# NVIDIA hash. Geometry regression: test/check_address_mapping.cc.
-gpgpu_ipoly_non_power2_balanced 3
-gpgpu_ipoly_channel_stable_l2slice 0
