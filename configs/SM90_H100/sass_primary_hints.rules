# Primary SASS hints for SASS-PTX-line guided reorder.
# Scope: H100 / sm_90a, CUDA 12.8.

[metadata]
rule_version = 1
arch = sm_90a
gpu = H100
toolchain = cuda_12_8
nvcc_version = 12.8.93
nvdisasm_version = 12.8.90

[primary_opcode]
ldmatrix.sync.aligned.x4.m8n8.shared.b16 = LDSM.16.M88.4
ldmatrix.sync.aligned.x4.trans.m8n8.shared.b16 = LDSM.16.MT88.4
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 = HMMA.16816.F32

# Softmax / normalization path.
max.ftz.f32 = FMNMX.FTZ
ex2.approx.ftz.f32 = MUFU.EX2
rcp.approx.ftz.f32 = MUFU.RCP
lg2.approx.ftz.f32 = MUFU.LG2
add.ftz.f32 = FADD.FTZ, FFMA.FTZ
mul.ftz.f32 = FMUL.FTZ, FFMA.FTZ
sub.ftz.f32 = FADD.FTZ, FFMA.FTZ
fma.rn.ftz.f32 = FFMA.FTZ
cvt.rn.f16x2.f32 = F2FP.F16.F32.PACK_AB
shfl.sync.bfly.b32 = SHFL.BFLY
setp.eq.ftz.f32 = FSETP.NEU.FTZ.AND, FSETP.NE.FTZ.AND
setp.equ.ftz.f32 = FSETP.NEU.FTZ.AND, FSETP.NE.FTZ.AND

[attached_opcode_allowlist]
# These were observed as non-primary SASS sharing a PTX line with one of the
# primary opcodes above on sm90a. They should not become guide anchors.
ldmatrix.sync.aligned.x4.m8n8.shared.b16 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
ldmatrix.sync.aligned.x4.trans.m8n8.shared.b16 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
max.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
ex2.approx.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
rcp.approx.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
lg2.approx.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
add.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
mul.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
sub.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
fma.rn.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
cvt.rn.f16x2.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
shfl.sync.bfly.b32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
setp.eq.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE
setp.equ.ftz.f32 = MOV, UIADD3, IADD3, IMAD, IMAD.IADD, IMAD.MOV.U32, ISETP.LT.OR, ISETP.GE.OR, ISETP.NE.OR, ISETP.NE.AND, ISETP.EQ.AND, LDL, LDL.64, LDL.LU, LDL.LU.64, LDL.S16, LDL.LU.S16, STL, STL.64, STL.S16, LDC, LDCU, ULDC, LOP3.LUT, LEA, PRMT, P2R, NOP, BSSY, BSSY.RECONVERGENT, BRA, UMOV, WARPSYNC.COLLECTIVE, ENDCOLLECTIVE

[policy]
unknown_arch = fatal
toolchain_mismatch = fatal
missing_primary_rule = fatal
zero_primary_candidate = fatal
multiple_primary_candidates_without_explicit_hint = fatal
unexpected_attached_opcode = fatal
fallback = disabled
